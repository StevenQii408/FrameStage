{
  "name": "ai-storyboard-workbench",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "vue-tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:layout": "vitest run tests/scene-layout.spec.ts tests/event-prompt-layout.spec.ts tests/sequence-branch-regressions.spec.ts"
  },
  "dependencies": {
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/core": "^1.45.0",
    "@vueuse/motion": "^2.2.6",
    "gsap": "^3.15.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.7.2",
    "vite": "6.4.6",
    "vitest": "4.1.12",
    "vue-tsc": "3.3.14",
    "@types/node": "^22.0.0"
  },
  "overrides": {
    "js-beautify": {
      "editorconfig": "4.0.0",
      "glob": "14.0.4"
    }
  }
}
