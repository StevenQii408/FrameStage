STORYBOARD_DATA_DIR=./data
STORYBOARD_PROVIDER=bailian
STORYBOARD_SCRIPT_STRATEGY=director-v3
# 默认云端；Key 由 app.cloud_setup 保存到被 Git 忽略的私有 backend/.env
STORYBOARD_CLOUD_MODEL=qwen3.8-flash
# 国内百炼默认直连；只有明确需要环境代理时改为 1。
STORYBOARD_CLOUD_TRUST_ENV=0
# 连接握手不应消耗整段模型推理时间；与响应读取超时分开。
STORYBOARD_CLOUD_CONNECT_TIMEOUT_SECONDS=8
STORYBOARD_CLOUD_READ_TIMEOUT_SECONDS=75
# Shadow evidence v2 is on; set 0 only for explicit old-structure baseline evaluation.
STORYBOARD_PERCEPTION_V2=1
STORYBOARD_STYLE_STRATEGY=qwen-direct-v3
STORYBOARD_STYLE_TEXT_EMBED_MODEL=text-embedding-v4
STORYBOARD_STYLE_VISION_EMBED_MODEL=qwen3-vl-embedding
STORYBOARD_STYLE_EMBED_DIMENSION=1024
STORYBOARD_STYLE_EMBED_CONCURRENCY=4
# 显式允许本机 HTTP 请求触发付费索引重建；通常保持关闭，使用 CLI 构建。
STORYBOARD_STYLE_ALLOW_API_REBUILD=0
STORYBOARD_BAILIAN_BASE_URL=
# STORYBOARD_BAILIAN_API_KEY=
STORYBOARD_CORS_ORIGINS=http://127.0.0.1:5174,http://localhost:5174,http://127.0.0.1:5173,http://localhost:5173
# Local single-user API boundary. Keep authentication enabled for normal use.
# The browser gets a short-lived process token automatically; never use the cloud Key here.
STORYBOARD_LOCAL_AUTH=1
STORYBOARD_ALLOWED_HOSTS=127.0.0.1,localhost,::1
# Optional CLI token (32+ random characters), otherwise generated on each backend start.
# STORYBOARD_LOCAL_API_TOKEN=
STORYBOARD_MAX_VIDEO_SIZE_MB=2048
STORYBOARD_MAX_VIDEO_DURATION_SECONDS=600
# 通用本机处理保护，不再为本地模型预留 16–20GB；云端请求不受本地推理阈值阻塞。
STORYBOARD_MIN_AVAILABLE_MEMORY_GB=1
STORYBOARD_TARGET_AVAILABLE_MEMORY_GB=2
STORYBOARD_VLM_MAX_CONTEXT_TOKENS=4096
STORYBOARD_VLM_MAX_NEW_TOKENS=512
STORYBOARD_FRAMES_PER_SHOT=4
STORYBOARD_SEGMENTATION_PROFILE=source-boundaries-v4
STORYBOARD_NARRATIVE_MIN_SECONDS=1.2
STORYBOARD_NARRATIVE_MAX_SECONDS=5.0
STORYBOARD_MAX_RAW_SHOTS_PER_NARRATIVE=4
STORYBOARD_HOST=127.0.0.1
STORYBOARD_PORT=8000
# Runtime limits count failed attempts too; cost remains an estimate, not a billing cap.
STORYBOARD_JOB_MAX_MODEL_CALLS=424
STORYBOARD_JOB_TIMEOUT_SECONDS=3600
# Analysis admission includes both running and queued jobs; full queues return HTTP 429.
STORYBOARD_MAX_PENDING_JOBS=8

# Image/video generation is opt-in and separate from Flash storyboard analysis.
# Existing Beijing Bailian keys are reused; app.generation_setup never calls an API.
STORYBOARD_GENERATION_ENABLED=0
STORYBOARD_IMAGE_MODEL=qwen-image-3.0-pro
STORYBOARD_VIDEO_MODEL=wan3.0-video
# Optional overrides: default to STORYBOARD_BAILIAN_BASE_URL and its regional Key.
# Base URL uses the native /api/v1 path; /compatible-mode/v1 is converted locally.
# STORYBOARD_IMAGE_BASE_URL=
# STORYBOARD_IMAGE_API_KEY=
# STORYBOARD_VIDEO_BASE_URL=
# STORYBOARD_VIDEO_API_KEY=
STORYBOARD_GENERATION_MAX_INFLIGHT=16
# Qwen Image 3.0 Pro's documented default async concurrency is 10, submission RPM 5.
# Verify your account quota before raising either limit.
STORYBOARD_IMAGE_MAX_INFLIGHT=10
STORYBOARD_VIDEO_MAX_INFLIGHT=16
STORYBOARD_GENERATION_MAX_PENDING=100
STORYBOARD_GENERATION_IO_WORKERS=4
STORYBOARD_GENERATION_DOWNLOAD_WORKERS=2
STORYBOARD_GENERATION_IMAGE_FINALIZE_WORKERS=2
STORYBOARD_GENERATION_VIDEO_FINALIZE_WORKERS=2
STORYBOARD_GENERATION_POLL_INTERVAL_SECONDS=15
STORYBOARD_GENERATION_TIMEOUT_SECONDS=1800
STORYBOARD_GENERATION_REQUEST_TIMEOUT_SECONDS=60
STORYBOARD_IMAGE_SUBMIT_RPM=5
STORYBOARD_VIDEO_SUBMIT_RPM=5
STORYBOARD_GENERATION_TRUST_ENV=0
